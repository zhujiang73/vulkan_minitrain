# build output
build/
build-*/
out/
*.obj
*.pdb
*.ilk
*.lib
*.exp

# downloaded or generated by fetch-assets.py (never commit model weights or corpora)
assets/
!assets/.gitkeep

# experiment logs and QA renders (referenced by the reports, but too large to track)
docs/*.log
docs/preview-*/
docs/checks-*.json

# python
__pycache__/
*.pyc

# trained models (~94 MB each): keep the directory, ignore its contents
output/*
!output/.gitkeep

# archived original weights (~188 MB): tracked only through its README
backup/*.gguf

# Vulkan baseline run artefacts
output-vk/

# PDF sources produced by the report pipeline (keep the PDFs, not the docx)
docs/*.docx

# PDFs are a local build artefact (git history keeps the Markdown + figures)
docs/*.pdf
