#version 450

#extension GL_EXT_shader_16bit_storage : require

layout (push_constant) uniform parameter
{
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23; uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

uint get_aoffset() { return p.misalign_offsets >> 16; }
uint get_boffset() { return (p.misalign_offsets >> 8) & 0xFF; }
uint get_doffset() { return p.misalign_offsets & 0xFF; }

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// shared-memory tiled GEMM: one workgroup computes a TM x TN tile of dst.
// 256 threads, each thread holds a 4x4 register block.
#define TM 64   // dst rows (i) per workgroup
#define TN 64   // dst cols (j) per workgroup
#define TK 16   // contraction step
#define WM 4    // per-thread rows
#define WN 4    // per-thread cols
#define TX 16   // threads along j
#define TY 16   // threads along i

// pad the row stride by one float: without it every thread of a warp hits the same
// shared-memory bank (stride 64 floats == 0 mod 32), serialising the inner loop
shared float As[TM][TK + 1];
shared float Bs[TN][TK + 1];

void main() {
    const uint tid  = gl_LocalInvocationID.x;      // 0..255
    const uint tx   = tid % TX;                    // thread column block
    const uint ty   = tid / TX;                    // thread row block
    const uint wgs  = gl_NumWorkGroups.x;          // dispatched workgroups (grid stride)
    const uint nt0  = (p.ne20 + TM - 1) / TM;
    const uint nt1  = (p.ne21 + TN - 1) / TN;
    const uint ntiles = nt0 * nt1 * p.ne22 * p.ne23;

    for (uint tile = gl_WorkGroupID.x; tile < ntiles; tile += wgs) {
        const uint t0 = tile % nt0;
        const uint t1 = (tile / nt0) % nt1;
        const uint i2 = (tile / (nt0 * nt1)) % p.ne22;
        const uint i3 = tile / (nt0 * nt1 * p.ne22);

        const uint i0 = t0 * TM;
        const uint i1 = t1 * TN;

        const uint a_i2 = i2 / (p.ne22 / p.ne02);
        const uint a_i3 = i3 / (p.ne23 / p.ne03);

        const uint abase = get_aoffset() + a_i3*p.nb03 + a_i2*p.nb02 + i0*p.nb00;
        const uint bbase = get_boffset() + i3*p.nb13 + i2*p.nb12 + i1*p.nb10;

        float c00 = 0.0f, c01 = 0.0f, c02 = 0.0f, c03 = 0.0f;
        float c10 = 0.0f, c11 = 0.0f, c12 = 0.0f, c13 = 0.0f;
        float c20 = 0.0f, c21 = 0.0f, c22 = 0.0f, c23 = 0.0f;
        float c30 = 0.0f, c31 = 0.0f, c32 = 0.0f, c33 = 0.0f;

        const uint K = p.ne01;
        for (uint k0 = 0; k0 < K; k0 += TK) {
            // cooperative load: 1024 elements per tile, 4 per thread, coalesced along i/j
            for (uint q = 0; q < 4; ++q) {
                const uint e  = tid + q * 256;
                const uint li = e % TM;
                const uint lk = e / TM;

                const uint gi = i0 + li;
                const uint gk = k0 + lk;
                As[li][lk] = (gi < p.ne20 && gk < K) ? data_a[abase + li*p.nb00 + gk*p.nb01] : 0.0f;

                const uint gj = i1 + li;
                Bs[li][lk] = (gj < p.ne21 && gk < K) ? data_b[bbase + li*p.nb10 + gk*p.nb11] : 0.0f;
            }
            barrier();

            for (uint k = 0; k < TK; ++k) {
                const float a0 = As[ty*WM + 0][k];
                const float a1 = As[ty*WM + 1][k];
                const float a2 = As[ty*WM + 2][k];
                const float a3 = As[ty*WM + 3][k];

                const float b0 = Bs[tx*WN + 0][k];
                const float b1 = Bs[tx*WN + 1][k];
                const float b2 = Bs[tx*WN + 2][k];
                const float b3 = Bs[tx*WN + 3][k];

                c00 += a0*b0; c01 += a0*b1; c02 += a0*b2; c03 += a0*b3;
                c10 += a1*b0; c11 += a1*b1; c12 += a1*b2; c13 += a1*b3;
                c20 += a2*b0; c21 += a2*b1; c22 += a2*b2; c23 += a2*b3;
                c30 += a3*b0; c31 += a3*b1; c32 += a3*b2; c33 += a3*b3;
            }
            barrier();
        }

        const uint gi0 = i0 + ty*WM;
        const uint gi1 = i1 + tx*WN;
        const uint db  = get_doffset() + i3*p.nb23 + i2*p.nb22 + gi1*p.nb21 + gi0*p.nb20;

        // absolute bounds: subtracting would underflow for threads past the tile edge
        const bool w0 = gi0 + 0 < p.ne20, w1 = gi0 + 1 < p.ne20, w2 = gi0 + 2 < p.ne20, w3 = gi0 + 3 < p.ne20;
        const bool v0 = gi1 + 0 < p.ne21, v1 = gi1 + 1 < p.ne21, v2 = gi1 + 2 < p.ne21, v3 = gi1 + 3 < p.ne21;

        if (w0 && v0) { data_d[db] = c00; }
        if (w0 && v1) { data_d[db + p.nb21] = c01; }
        if (w0 && v2) { data_d[db + 2*p.nb21] = c02; }
        if (w0 && v3) { data_d[db + 3*p.nb21] = c03; }
        if (w1 && v0) { data_d[db + p.nb20] = c10; }
        if (w1 && v1) { data_d[db + p.nb20 + p.nb21] = c11; }
        if (w1 && v2) { data_d[db + p.nb20 + 2*p.nb21] = c12; }
        if (w1 && v3) { data_d[db + p.nb20 + 3*p.nb21] = c13; }
        if (w2 && v0) { data_d[db + 2*p.nb20] = c20; }
        if (w2 && v1) { data_d[db + 2*p.nb20 + p.nb21] = c21; }
        if (w2 && v2) { data_d[db + 2*p.nb20 + 2*p.nb21] = c22; }
        if (w2 && v3) { data_d[db + 2*p.nb20 + 3*p.nb21] = c23; }
        if (w3 && v0) { data_d[db + 3*p.nb20] = c30; }
        if (w3 && v1) { data_d[db + 3*p.nb20 + p.nb21] = c31; }
        if (w3 && v2) { data_d[db + 3*p.nb20 + 2*p.nb21] = c32; }
        if (w3 && v3) { data_d[db + 3*p.nb20 + 3*p.nb21] = c33; }

        barrier();
    }
}
